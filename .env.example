# Google OAuth (NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=visionix_founders

# NVIDIA Nemotron (primary AI provider)
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# VEIXON AI OS — our own AI (Venture Decision Engine, Academy knowledge, OpenAI-compatible chat).
# Create a key in VEIXON AI OS (Workspace -> API keys) with the "chat" and "decisions" scopes.
# When both are set, VEIXON AI OS becomes the primary LLM provider and powers /academy/advisor;
# NVIDIA/OpenAI/... stay as fallbacks. Override the order with AI_PRIMARY_PROVIDER / AI_CHAIN_DEFAULT.
VEIXON_AIOS_URL=
VEIXON_AIOS_API_KEY=
VEIXON_MODEL=auto

# Emergent fallback (optional)
EMERGENT_LLM_KEY=
CLAUDE_MODEL_ID=claude-sonnet-4-20250514

# Resend (Monday Missile emails)
RESEND_API_KEY=

# Vercel cron protection
CRON_SECRET=

NEXT_PUBLIC_BASE_URL=https://founder-launchpad-11.preview.emergentagent.com
CORS_ORIGINS=*
